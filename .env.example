# Copy this file to .env (or just export these in your shell) and adjust as needed.

# Base URL of an OpenAI-compatible chat completions endpoint.
# Default below targets a local Ollama server.
LLM_BASE_URL=http://localhost:11434/v1

# API key. Ollama ignores this, but the OpenAI SDK requires something non-empty.
# If using real OpenAI: put your actual key here.
LLM_API_KEY=ollama

# Model name as known to your server, e.g.:
#   Ollama:  llama3.1, mistral, qwen2.5, etc. (must be `ollama pull`-ed first)
#   OpenAI:  gpt-4o-mini, gpt-4o, etc.
#   Groq:    llama-3.1-70b-versatile, etc. (set LLM_BASE_URL=https://api.groq.com/openai/v1)
LLM_MODEL=llama3.1
